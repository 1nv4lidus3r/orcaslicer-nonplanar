         m_object_label_id = get_object_label_id(comment);
@@ -5701,6 +5713,9 @@ void GCodeProcessor::store_move_vertex(EMoveType type, EMovePathType path_type,
         m_print_z
     });
 
+    // OrcaSlicer Nonplanar: carry the conformal-path flag of the current toolpath.
+    m_result.moves.back().nonplanar = m_nonplanar_current;
+
     if (type == EMoveType::Seam) {
         m_seams_count++;
     }
