diff --git a/src/libvgcode/src/ViewerImpl.cpp b/src/libvgcode/src/ViewerImpl.cpp
index 1c52ffe4..f8268400 100644
--- a/src/libvgcode/src/ViewerImpl.cpp
+++ b/src/libvgcode/src/ViewerImpl.cpp
@@ -304,6 +304,10 @@ static const std::array<Color, size_t(EGCodeExtrusionRole::COUNT)> DEFAULT_EXTRU
     { 128, 128, 128 }, // Mixed
 } };
 
+// OrcaSlicer Nonplanar: preview color of the conformal (nonplanar) top-shell paths.
+// Chosen to stand out from every extrusion-role color above (bright magenta).
+static const Color NONPLANAR_COLOR = { 255, 0, 200 };
+
 static const std::array<Color, size_t(EOptionType::COUNT)> DEFAULT_OPTIONS_COLORS{ {
     {  56,  72, 155 }, // Travels
     { 255, 255,   0 }, // Wipes
@@ -1469,6 +1473,11 @@ Color ViewerImpl::get_vertex_color(const PathVertex& v) const
     if (v.type == EMoveType::Noop)
         return DUMMY_COLOR;
 
+    // OrcaSlicer Nonplanar: conformal (nonplanar) top-shell paths are always drawn in
+    // their own color, so they are visible while checking the preview, whatever the view type.
+    if (v.nonplanar && v.is_extrusion())
+        return NONPLANAR_COLOR;
+
     if ((v.is_wipe() && (m_settings.view_type != EViewType::Speed && m_settings.view_type != EViewType::ActualSpeed && m_settings.view_type != EViewType::Acceleration && m_settings.view_type != EViewType::Jerk)) || v.is_option())
         return get_option_color(move_type_to_option(v.type));
 
diff --git a/src/slic3r/GUI/GCodeViewer.cpp b/src/slic3r/GUI/GCodeViewer.cpp
